page { background: #f6f2eb; color: #29251f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; }
view, button, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 0; font-weight: 500; border-radius: 12rpx; }
button::after { border: 0; }
image { display: block; }
button[disabled] { opacity: .55; }
