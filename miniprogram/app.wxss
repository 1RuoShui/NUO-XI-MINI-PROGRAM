/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* Profile avatar frame */
.profile .profile-avatar {
  border: 6rpx solid #d5a94f;
  box-shadow: 0 4rpx 14rpx rgba(111, 65, 14, 0.2);
  background: #f5ead2;
}

/* Unified heading treatment */
.header,
.home-brand,
.home-tagline,
.shop-title,
.shop-subtitle,
.module-title,
.section-title,
.detail-title,
.welcome,
.auth-brand,
.compose-title,
.product .name,
.post-title {
  font-family: KaiTi, STKaiti, serif;
  text-align: center;
}

.article-title,
.home-article-title,
.home-post-title {
  font-family: KaiTi, STKaiti, serif;
  text-align: center;
}
