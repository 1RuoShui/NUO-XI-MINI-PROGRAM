.compose-chip-active { background: #992c28; color: #fff8e9; }
.compose-images { display: flex; }
.compose-image { position: relative; margin-right: 14rpx; }
.compose-image image { width: 150rpx; height: 150rpx; border-radius: 8rpx; }
.compose-image text { position: absolute; top: 0; right: 0; background: #8e2c28; color: #fff; width: 38rpx; height: 38rpx; text-align: center; border-radius: 50%; }
.compose-actions { display: flex; justify-content: space-between; margin-top: 20rpx; }
.compose-actions button { font-size: 24rpx; line-height: 66rpx; height: 66rpx; padding: 0 24rpx; color: #896a48; background: #eee3d2; }
.compose-actions .primary-button { background: #992c28; color: #fff; }
.detail-top { display: flex; justify-content: space-between; align-items: center; color: #985838; font-size: 25rpx; padding: 28rpx 0; }
.detail-image { width: 100%; height: 500rpx; border-radius: 16rpx; background: #e4d6c0; }
.detail-category { display: block; font-size: 23rpx; margin-top: 32rpx; color: #9f7546; }
.detail-title { display: block; font-size: 45rpx; font-family: KaiTi,STKaiti,serif; font-weight: 700; line-height: 1.5; margin: 16rpx 0; }
.detail-excerpt { display: block; font-size: 28rpx; line-height: 1.8; padding-left: 22rpx; border-left: 5rpx solid #b18b57; color: #8b785d; margin: 24rpx 0 32rpx; }
.detail-section { margin: 30rpx 0; }
.detail-section-title { display: block; font-size: 33rpx; font-weight: 600; margin-bottom: 15rpx; }
.detail-paragraph { display: block; font-size: 28rpx; line-height: 2; color: #645748; margin-bottom: 20rpx; }
.detail-source { border-top: 1rpx solid #ded1bc; font-size: 22rpx; line-height: 1.8; color: #9a876d; padding: 24rpx 0; }
.product-detail-image { width: 100%; height: 630rpx; border-radius: 16rpx; }
.product-detail-tag { display: block; color: #a1794a; font-size: 24rpx; margin-top: 28rpx; }
.product-detail-title { display: block; font-size: 40rpx; font-family: KaiTi,STKaiti,serif; font-weight: 700; margin-top: 12rpx; }
.product-detail-price { display: block; color: #9a3029; font-size: 47rpx; font-family: Georgia,serif; margin: 22rpx 0; }
.product-detail-desc { display: block; font-size: 27rpx; color: #897861; line-height: 1.8; }
.subheading { display: block; font-size: 29rpx; font-weight: 600; margin: 32rpx 0 20rpx; }
.specs { display: flex; flex-wrap: wrap; }
.spec { padding: 14rpx 22rpx; border: 1rpx solid #dfd2be; border-radius: 9rpx; font-size: 24rpx; color: #867052; margin: 0 14rpx 14rpx 0; }
.spec-active { color: #922d28; border-color: #992c28; background: #f2e3d7; }
.quantity { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0 30rpx; }
.quantity > view { display: flex; align-items: center; }
.quantity-button { display: inline-block; width: 62rpx; height: 60rpx; line-height: 60rpx; text-align: center; background: #eae1d3; border-radius: 8rpx; }
.quantity-number { width: 80rpx; text-align: center; }
.primary-button { display: block; width: 100%; background: #992c28; color: #fff8ec; height: 84rpx; line-height: 84rpx; font-size: 28rpx; border-radius: 12rpx; }
.detail-copy { margin-top: 35rpx; border-top: 1rpx solid #e1d3bc; }
.small-title { font-size: 44rpx; }
.cart-tip { display: block; color: #92795c; font-size: 24rpx; margin: 12rpx 0 28rpx; line-height: 1.8; }
.cart-row { display: flex; padding: 22rpx 0; border-bottom: 1rpx solid #e3d6c1; }
.cart-row > image { width: 150rpx; height: 190rpx; border-radius: 10rpx; margin-right: 22rpx; flex-shrink: 0; }
.cart-info { flex: 1; min-width: 0; font-size: 27rpx; line-height: 1.6; }
.cart-info > text { display: block; }
.cart-spec { font-size: 22rpx; color: #9c7e59; margin: 10rpx 0; }
.cart-controls { display: flex; align-items: center; justify-content: space-between; }
.remove { color: #aa503b; font-size: 23rpx; }
.cart-bottom { background: #eae0ce; border-radius: 14rpx; padding: 24rpx; margin-top: 26rpx; }
.cart-bottom > view { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.cart-total { color: #98362c; font-family: Georgia,serif; font-size: 44rpx; }
.search-result { background: #fffcf7; border-radius: 16rpx; padding: 24rpx; }
.result-head { display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; font-weight: 600; }
.muted { font-size: 23rpx; font-weight: 400; color: #a18769; }
.result-group { margin-top: 25rpx; }
.result-label { color: #9b372c; font-size: 25rpx; font-weight: 600; }
.result-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #eadecb; font-size: 25rpx; line-height: 1.7; }
.result-row text:first-child { flex: 1; padding-right: 20rpx; }
.empty { display: block; padding: 48rpx 20rpx; color: #948066; text-align: center; font-size: 25rpx; line-height: 1.8; }
.profile-hero { text-align: center; padding: 42rpx 20rpx 28rpx; }
.profile-avatar-wrap { position: relative; width: 148rpx; margin: auto; }
.profile-avatar { width: 148rpx; height: 148rpx; border-radius: 50%; background: #e9dcc5; border: 5rpx solid #cfb284; }
.profile-seal { position: absolute; bottom: 0; right: 0; width: 44rpx; height: 48rpx; line-height: 48rpx; background: #962f28; color: #f2d7a2; border-radius: 4rpx; font-family: KaiTi,STKaiti,serif; }
.profile-name { display: block; font-size: 40rpx; font-weight: 600; margin-top: 22rpx; }
.profile-account { display: block; font-size: 23rpx; color: #a28d70; margin-top: 8rpx; }
.profile-welcome { display: block; font-size: 24rpx; color: #8c7759; margin: 20rpx 0; }
.outline-button { display: inline-block; padding: 0 36rpx; height: 65rpx; line-height: 65rpx; border: 1rpx solid #bca17a; color: #8b5938; background: transparent; font-size: 24rpx; border-radius: 35rpx; }
.profile-menu { background: #fffdf7; border-radius: 18rpx; padding: 0 26rpx; border: 1rpx solid #e4d7c3; margin-top: 20rpx; }
.profile-menu-row { display: flex; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid #ede3d4; }
.profile-menu-row:last-child { border: 0; }
.profile-menu-row > text:first-child { width: 54rpx; font-size: 35rpx; color: #a57543; }
.profile-menu-row > view { flex: 1; }
.profile-menu-row > view text { display: block; font-size: 28rpx; }
.profile-menu-row > view text:last-child { font-size: 22rpx; color: #a18b6d; margin-top: 7rpx; }
.profile-panel { background: #fffaf0; border: 1rpx solid #e2d3bc; border-radius: 14rpx; padding: 24rpx; margin-top: 24rpx; }
.panel-title { display: block; font-size: 31rpx; font-weight: 600; margin-bottom: 18rpx; }
.panel-row,.intention-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #eadcc7; font-size: 25rpx; line-height: 1.8; }
.about > text:not(.panel-title) { display: block; font-size: 25rpx; color: #8c7454; line-height: 1.9; margin-bottom: 12rpx; }
.logout-button { background: transparent; color: #9a6641; font-size: 25rpx; margin: 30rpx auto; }
.profile-edit { padding: 26rpx; border: 1rpx solid #e3d4bc; background: #fffcf4; border-radius: 14rpx; }
.choose-avatar { background: transparent; font-size: 24rpx; color: #93744d; text-align: center; margin-bottom: 20rpx; }
.choose-avatar image { width: 120rpx; height: 120rpx; border-radius: 50%; margin: auto; }
.profile-edit input { display: block; width: 100%; height: 80rpx; background: #f0e7d8; padding: 0 22rpx; border-radius: 10rpx; margin: 22rpx 0; font-size: 27rpx; }
.edit-tip { display: block; font-size: 21rpx; color: #9b8260; margin-top: 18rpx; line-height: 1.8; }
.login-page { padding: 50rpx 24rpx 24rpx; text-align: center; }
.login-seal { display: block; margin: 0 auto 26rpx; width: 124rpx; height: 138rpx; line-height: 138rpx; background: #992c28; border-radius: 8rpx; font-family: KaiTi,STKaiti,serif; font-size: 83rpx; color: #f3daa4; }
.login-title { display: block; font-family: KaiTi,STKaiti,serif; font-size: 48rpx; font-weight: 700; }
.login-subtitle { display: block; margin: 22rpx 0 32rpx; font-size: 26rpx; color: #917d61; line-height: 1.8; }
.wechat-button { display: block; width: 100%; background: #315f4e; color: #fff; height: 86rpx; line-height: 86rpx; font-size: 29rpx; border-radius: 12rpx; }
.login-or { display: block; font-size: 22rpx; color: #9b896f; margin-top: 20rpx; line-height: 1.7; }
.auth-message { display: block; color: #a44530; font-size: 24rpx; line-height: 1.8; margin-top: 20rpx; }
.login-help { margin-top: 30rpx; padding: 24rpx 0; border-top: 1rpx solid #e0d0b7; }
.login-help text { display: block; color: #998263; font-size: 22rpx; line-height: 1.8; }
.tabbar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; height: calc(116rpx + env(safe-area-inset-bottom)); padding: 10rpx 16rpx env(safe-area-inset-bottom); display: flex; background: #fffcf6; border-top: 1rpx solid #e5dac8; box-shadow: 0 -5rpx 25rpx rgba(61,41,18,.04); }
.tab { flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; font-size: 22rpx; color: #9b8c78; }
.tab-icon-wrap { position: relative; padding: 5rpx 22rpx; border-radius: 28rpx; margin-bottom: 4rpx; }
.tab-icon-wrap image { width: 42rpx; height: 42rpx; opacity: .55; }
.tab-active { color: #962e26; font-weight: 600; }
.tab-active .tab-icon-wrap { background: #f1e1d1; }
.tab-active image { opacity: 1; }
.tab-badge { position: absolute; right: 1rpx; top: 0; background: #a3392c; color: #fff; font-size: 18rpx; min-width: 28rpx; padding: 0 5rpx; text-align: center; border-radius: 20rpx; }
.local-note { display: block; color: #8c7961; font-size: 22rpx; line-height: 1.7; margin-bottom: 20rpx; }
.intention-row { flex-wrap: wrap; }
.intention-items { width: 100%; margin-top: 10rpx; }
.intention-items text { display: block; font-size: 23rpx; color: #8b765a; line-height: 1.9; }
.intention-del { display: block; width: 100%; margin-top: 12rpx; text-align: right; font-size: 23rpx; color: #aa503b; }
.comment-row { position: relative; padding-right: 78rpx; }
.comment-del { position: absolute; right: 0; top: 0; font-size: 23rpx; color: #aa503b; }
.ghost-button { background: transparent; color: #9a6641; border: 1rpx solid #d8c6ab; font-size: 25rpx; margin-top: 16rpx; }
