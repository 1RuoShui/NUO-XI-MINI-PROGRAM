.shop-search { margin-bottom: 15rpx; }
.shop-chips { padding-bottom: 10rpx; }
.shop-actions { display: flex; justify-content: space-between; padding: 14rpx 0 26rpx; font-size: 24rpx; color: #8f7356; }
.cart-badge { display: inline-block; min-width: 32rpx; text-align: center; color: #fff; background: #a13831; border-radius: 30rpx; font-size: 20rpx; padding: 2rpx 7rpx; }
.shop-grid .product-name { min-height: 82rpx; }
.shop-footnote { border-top: 1rpx solid #ddd1bf; padding: 26rpx 10rpx; }
