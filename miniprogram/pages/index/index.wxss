.shop-footnote text:first-child { color: #695740; margin-bottom: 6rpx; font-weight: 600; }
.community-intro { padding-bottom: 18rpx; }
.community-stats { display: flex; padding: 24rpx 0; background: #302923; color: #ecd6aa; border-radius: 16rpx; margin: 5rpx 0 26rpx; }
.community-stats > view { flex: 1; text-align: center; border-right: 1rpx solid #5b4a3a; }
.community-stats > view:last-child { border: 0; }
