.post-actions { display: flex; justify-content: space-between; color: #987955; font-size: 24rpx; padding: 20rpx 0; }
.comment-list { background: #f5eee4; border-radius: 8rpx; padding: 16rpx; font-size: 23rpx; line-height: 1.8; }
.comment-author { color: #956548; }
.comment-input { display: flex; margin-top: 15rpx; align-items: center; }
.comment-input input { flex: 1; min-width: 0; height: 62rpx; border-radius: 8rpx; background: #f3eee6; padding: 0 15rpx; font-size: 23rpx; }
.comment-input button { font-size: 23rpx; color: #a04732; background: transparent; width: 90rpx; line-height: 62rpx; }
.compose { background: #fffdf8; border: 1rpx solid #e2d6c3; padding: 24rpx; margin-bottom: 26rpx; border-radius: 16rpx; }
.compose textarea { width: 100%; height: 170rpx; font-size: 26rpx; line-height: 1.7; }
.compose-topics { display: flex; flex-wrap: wrap; margin: 16rpx 0; }
