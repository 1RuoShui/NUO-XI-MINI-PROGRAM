.page { min-height: 100vh; padding-bottom: calc(145rpx + env(safe-area-inset-bottom)); }
.content { padding: 0 32rpx; }
.topbar { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx 18rpx; border-bottom: 1rpx solid #e8dfd1; }
.topbar-brand { display: flex; align-items: center; }
.seal { background: #992c28; color: #f9e6bb; width: 64rpx; height: 70rpx; line-height: 68rpx; text-align: center; font-size: 42rpx; font-family: KaiTi, STKaiti, serif; border-radius: 4rpx; margin-right: 17rpx; }
.brand-name { display: block; font-size: 35rpx; font-family: KaiTi, STKaiti, serif; font-weight: 700; letter-spacing: 5rpx; }
.brand-sub { display: block; font-size: 19rpx; color: #8b7a65; letter-spacing: 2rpx; margin-top: 4rpx; }
.topbar-label { font-size: 24rpx; color: #8c7560; border: 1rpx solid #d6c5ae; border-radius: 30rpx; padding: 8rpx 22rpx; }
.home-hero-intro { padding: 32rpx 0 22rpx; }
.eyebrow,.page-kicker,.section-kicker { display: block; color: #9a7543; font-size: 20rpx; letter-spacing: 3rpx; }
.home-title { display: block; font-family: KaiTi, STKaiti, serif; font-weight: 700; font-size: 46rpx; line-height: 1.5; margin: 8rpx 0; }
.accent { color: #9b302b; }
.home-copy { display: block; color: #83786a; font-size: 23rpx; line-height: 1.7; }
.search-bar { display: flex; align-items: center; padding: 8rpx 9rpx 8rpx 20rpx; background: #fffdf9; border: 1rpx solid #e7ded1; border-radius: 16rpx; margin-bottom: 26rpx; }
.search-icon { font-size: 40rpx; margin-right: 12rpx; color: #a39682; }
.search-bar input { flex: 1; min-width: 0; font-size: 24rpx; height: 58rpx; }
.search-bar button { flex-shrink: 0; width: 102rpx; height: 58rpx; line-height: 58rpx; font-size: 24rpx; color: #fff9ed; background: #992c28; border-radius: 10rpx; }
.clear { font-size: 34rpx; color: #8f8170; padding: 0 14rpx; }
.hero-swiper { height: 490rpx; border-radius: 18rpx; overflow: hidden; background: #241f1c; }
.hero-swiper swiper-item { position: relative; }
.hero-swiper image { width: 100%; height: 100%; object-position: center 38%; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg,rgba(20,16,14,.85),rgba(20,16,14,.1)),linear-gradient(0deg,rgba(20,16,14,.45),transparent); }
.hero-caption { position: absolute; top: 38rpx; left: 32rpx; right: 28rpx; color: #fff8e9; }
.hero-label { display: inline-block; font-size: 21rpx; color: #efd6a2; border-bottom: 1rpx solid #967845; padding-bottom: 10rpx; }
.hero-title { display: block; font-family: KaiTi,STKaiti,serif; font-size: 64rpx; line-height: 1.25; font-weight: 700; white-space: pre-line; letter-spacing: 4rpx; margin: 24rpx 0 20rpx; }
.hero-subtitle { display: block; font-size: 22rpx; line-height: 1.6; max-width: 370rpx; opacity: .88; }
.hero-link { display: inline-block; margin-top: 23rpx; color: #ead39c; font-size: 23rpx; }
.quick-grid { display: flex; margin: 24rpx 0 6rpx; background: #fffcf6; border: 1rpx solid #e8dfd1; border-radius: 16rpx; padding: 22rpx 0; }
.quick-card { flex: 1; padding: 0 14rpx; text-align: center; border-right: 1rpx solid #ece1d1; }
.quick-card:last-child { border-right: 0; }
.quick-number { display: block; font-family: Georgia,serif; color: #b1834b; font-size: 30rpx; font-style: italic; }
.quick-title { display: block; margin: 8rpx 0; font-size: 27rpx; font-weight: 600; }
.quick-note { display: block; font-size: 20rpx; color: #948674; }
.section-heading { display: flex; justify-content: space-between; align-items: center; padding: 36rpx 0 22rpx; }
.section-kicker { font-size: 17rpx; letter-spacing: 3rpx; margin-bottom: 5rpx; }
.section-title { display: block; font-family: KaiTi,STKaiti,serif; font-size: 37rpx; font-weight: 700; }
.more { color: #936343; font-size: 23rpx; }
.product-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.product-card { width: 48.3%; margin-bottom: 24rpx; border-radius: 16rpx; overflow: hidden; background: #fffdf8; border: 1rpx solid #ebe2d4; }
.product-card > image { width: 100%; height: 316rpx; background: #eee4d6; }
.product-card-info { padding: 20rpx; }
