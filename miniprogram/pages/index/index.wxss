.article-card { background: #fffcf6; border: 1rpx solid #e9dfd0; border-radius: 18rpx; overflow: hidden; margin-bottom: 28rpx; }
.article-card > image { width: 100%; height: 370rpx; background: #dcd1bf; }
.article-card-body { padding: 26rpx; }
.article-card-title { display: block; font-family: KaiTi,STKaiti,serif; font-weight: 700; font-size: 36rpx; line-height: 1.5; }
.article-card-excerpt { display: block; margin-top: 12rpx; color: #8e8070; font-size: 25rpx; line-height: 1.7; }
.article-card-foot { display: flex; justify-content: space-between; align-items: center; border-top: 1rpx solid #ece3d7; margin-top: 20rpx; padding-top: 12rpx; color: #9e6a40; font-size: 23rpx; }
.discover-note { display: flex; border: 1rpx solid #e3d6c2; padding: 26rpx; border-radius: 14rpx; color: #8a7457; }
