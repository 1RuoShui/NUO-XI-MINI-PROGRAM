.product-name { display: block; font-size: 27rpx; line-height: 1.5; font-weight: 600; }
.product-price { display: block; font-family: Georgia,serif; color: #a0352e; font-size: 32rpx; margin-top: 12rpx; }
.product-description { display: block; font-size: 22rpx; line-height: 1.6; color: #8d8173; margin-top: 10rpx; }
.product-card-foot { display: flex; align-items: center; justify-content: space-between; }
.arrow { color: #b49572; font-size: 36rpx; flex-shrink: 0; }
.home-article { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #e6ddce; }
.home-article > image { flex-shrink: 0; width: 150rpx; height: 150rpx; border-radius: 12rpx; margin-right: 22rpx; }
.home-article > view { flex: 1; min-width: 0; }
.article-category { display: block; color: #a07142; font-size: 21rpx; margin-bottom: 8rpx; }
.home-article-title { display: block; font-size: 27rpx; line-height: 1.5; font-weight: 600; }
.home-article-excerpt { display: block; font-size: 22rpx; color: #928573; line-height: 1.5; margin-top: 7rpx; }
.home-community { background: #ece5d9; padding: 0 24rpx 24rpx; border-radius: 16rpx; margin-top: 32rpx; }
.compact { padding-top: 24rpx; }
.home-post-title { font-size: 26rpx; line-height: 1.8; }
.home-post-meta { display: block; font-size: 21rpx; color: #9a7e60; margin-top: 15rpx; }
.page-intro,.shop-intro { padding: 38rpx 0 24rpx; }
.page-title { display: block; font-family: KaiTi,STKaiti,serif; font-size: 55rpx; font-weight: 700; letter-spacing: 3rpx; margin: 12rpx 0 14rpx; }
.page-subtitle { display: block; font-size: 25rpx; line-height: 1.7; color: #867868; }
.chips { width: 100%; white-space: nowrap; padding: 8rpx 0 24rpx; }
.chip { display: inline-block; padding: 13rpx 23rpx; margin-right: 12rpx; border-radius: 36rpx; font-size: 24rpx; background: #ebe5db; color: #7e7161; }
