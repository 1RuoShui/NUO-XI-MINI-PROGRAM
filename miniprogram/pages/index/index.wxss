.post-author { display: block; font-size: 26rpx; font-weight: 600; }
.post-meta { display: block; font-size: 21rpx; color: #aa9580; margin-top: 6rpx; }
.post-delete { margin-left: auto; font-size: 34rpx; padding: 15rpx; }
.post-title { display: block; font-size: 27rpx; line-height: 1.9; margin-top: 23rpx; }
.post-images { display: flex; flex-wrap: wrap; margin: 20rpx -5rpx 0; }
