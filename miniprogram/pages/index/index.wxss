.discover-note view text { display: block; font-size: 23rpx; line-height: 1.8; }
.discover-note view text:first-child { font-weight: 600; color: #544734; margin-bottom: 6rpx; }
.shop-intro { text-align: center; padding-bottom: 28rpx; }
.shop-intro .page-title { color: #922b25; font-size: 62rpx; }
