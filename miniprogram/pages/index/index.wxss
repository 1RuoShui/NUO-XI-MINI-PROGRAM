.community-stats text:first-child { font-family: Georgia,serif; font-size: 38rpx; margin-bottom: 6rpx; }
.topic-bar > button { width: 100%; height: 76rpx; line-height: 76rpx; background: #f0e4d4; border: 1rpx dashed #c8ac86; color: #9b3b2f; font-size: 26rpx; margin-bottom: 24rpx; }
.post-card { background: #fffdf8; padding: 26rpx; border-radius: 18rpx; border: 1rpx solid #e8dfd2; margin-bottom: 24rpx; }
.post-head { display: flex; align-items: center; }
